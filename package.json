{
  "name": "sketchlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "손그림을 교과서 품질의 도형·그래프·수식·화학구조로 바꾸는 크로스플랫폼 웹 도구",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "npm run build --workspace client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
