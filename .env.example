# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋되지 않습니다.
# 서버(server/)에서만 읽습니다. 클라이언트 번들에 API 키가 들어가면 안 됩니다 (§4 금지 항목).

# Anthropic API 키. https://console.anthropic.com 에서 발급.
# P3(VLM 인식)부터 필요합니다. P0~P2 는 없어도 동작합니다.
ANTHROPIC_API_KEY=

# 인식 API를 호출할 수 있는 출처 목록. 쉼표 구분. "*" 금지 (§7.5).
# 개발 예시: https://localhost:5173,https://192.168.x.x:5173
ALLOWED_ORIGINS=https://localhost:5173

# API 프록시 포트
PORT=8787
